diff --git a/packages/core/src/zig/android_heap_compat.c b/packages/core/src/zig/android_heap_compat.c
new file mode 100644
index 0000000..16c2208
--- /dev/null
+++ b/packages/core/src/zig/android_heap_compat.c
@@ -0,0 +1,27 @@
+/*
+ * Android's Scudo allocator returns TBI-tagged pointers (nonzero top byte).
+ * Bun's FFI models native pointers as f64 JS numbers, which cannot represent
+ * 64-bit tagged addresses exactly, so any malloc-backed pointer that crosses
+ * the FFI boundary (Yoga nodes, NativeSpanFeed streams) comes back corrupted
+ * and the next native use or free aborts under Scudo's header checks.
+ *
+ * Downgrading the process heap tagging level is explicitly allowed at any
+ * time by bionic, and this constructor runs at dlopen before this library
+ * hands out any allocation.
+ *
+ * mallopt and the tagging constants are hidden by the NDK headers below API
+ * 26/31, so they are declared locally and mallopt is bound weakly: on the
+ * pre-Android-11 devices where the symbol or option is missing, heap tagging
+ * does not exist either, and the constructor degrades to a no-op.
+ */
+
+#define OPENTUI_M_BIONIC_SET_HEAP_TAGGING_LEVEL (-204)
+#define OPENTUI_M_HEAP_TAGGING_LEVEL_NONE 0
+
+extern int mallopt(int __option, int __value) __attribute__((weak));
+
+__attribute__((constructor)) static void opentui_android_disable_heap_tagging(void) {
+	if (&mallopt != 0) {
+		mallopt(OPENTUI_M_BIONIC_SET_HEAP_TAGGING_LEVEL, OPENTUI_M_HEAP_TAGGING_LEVEL_NONE);
+	}
+}
